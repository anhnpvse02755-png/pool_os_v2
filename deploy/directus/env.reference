TZ=Asia/Ho_Chi_Minh
KEY=<sinh lúc deploy>
SECRET=<sinh lúc deploy>

ADMIN_EMAIL=admin@poolos.vn
ADMIN_PASSWORD=<sinh lúc deploy>
PUBLIC_URL="https://poolos-api.kjdybl.easypanel.host"

HOST=0.0.0.0
PORT=8055

DB_CLIENT=pg
DB_HOST=test-va_db
DB_PORT=5432
DB_DATABASE=poolos
DB_USER=postgres
DB_PASSWORD=<sinh lúc deploy>

REDIS=<sinh lúc deploy>
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_AUTO_PURGE=true
RATE_LIMITER_ENABLED=false

# App Flutter Web gọi từ origin khác -> phải bật CORS
CORS_ENABLED=true
CORS_ORIGIN="https://poolos.kjdybl.easypanel.host"
CORS_CREDENTIALS=true

# Email: mailpit bắt toàn bộ, không cần credential
EMAIL_TRANSPORT=smtp
EMAIL_FROM="no-reply@poolos.vn"
EMAIL_SMTP_HOST=test-va_mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_IGNORE_TLS=true
EMAIL_SMTP_POOL=false

# KHÔNG dùng ký tự # trong giá trị: file .env coi đó là comment và cắt cụt
PASSWORD_RESET_URL_ALLOW_LIST="https://poolos.kjdybl.easypanel.host/reset-password"

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
